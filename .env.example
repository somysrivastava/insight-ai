# Copy to .env and fill in real values. .env is gitignored and never
# committed — this file is the safe, placeholder-only template that is.

# --- Auth ---
SECRET_KEY=changeme-generate-a-real-random-secret
ALGORITHM=HS256
# Note: this is ACCESS_TOKEN_EXPIRE_MINUTES (plural). The real local .env
# currently has this typo'd as ACCESS_TOKEN_EXPIRE_MINUTE, which
# auth_service.py doesn't read — it silently falls back to a 30-minute
# default. Harmless today, but worth renaming in your real .env
# whenever convenient (see docs/ARCHITECTURE.md #3.5).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
# Used directly when running the app on the host (uvicorn, no Docker).
# Under `docker compose up`, docker-compose.yml overrides this with a
# value built from POSTGRES_USER/PASSWORD/DB below, pointed at the `db`
# service instead of localhost.
DATABASE_URL=postgresql://insightai:insightai@localhost:5432/insightai_dev

# Consumed by docker-compose.yml for the postgres container AND to build
# the app container's DATABASE_URL override — one source of truth for
# both, rather than two values that can drift apart.
POSTGRES_USER=insightai
POSTGRES_PASSWORD=insightai
POSTGRES_DB=insightai_dev

# --- Test database (Day 27) ---
# Name only — same POSTGRES_USER/PASSWORD above, different database, on
# a separate `test-db` container so `docker compose run --rm test` never
# touches insightai_dev. See docs/ADR.md ADR-022.
POSTGRES_TEST_DB=insightai_test

# --- Storage ---
# "local" (default) or "s3". S3 stays wired up but inactive until this
# is set — see app/services/storage_service.py and docs/ADR.md ADR-004.
STORAGE_BACKEND=local

# Only read when STORAGE_BACKEND=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# --- AI natural-language queries (Day 14) ---
# Real key never goes in this file or in git — add it to your local .env.
OPENAI_API_KEY=
# Configurable so swapping models later is a config change, not a code
# change — see app/services/ai_service.py.
OPENAI_MODEL=gpt-4o-mini

# --- Background jobs (Day 15) ---
# Used directly when running the app on the host, no Docker. Under
# `docker compose up`, docker-compose.yml overrides this to point at the
# `redis` service instead of localhost — same pattern as DATABASE_URL
# above. Celery broker and result backend both use this same URL.
REDIS_URL=redis://localhost:6379/0

# --- Scheduled report emails (Day 19) ---
# Real key never goes in this file or in git — add it to your local .env.
# Free tier (100/day) is enough for dev — see docs/ADR.md ADR-014.
SENDGRID_API_KEY=
# Must be a sender address verified in your SendGrid account, or
# SendGrid rejects the send.
SENDGRID_FROM_EMAIL=

# --- Rate limiting (Day 25) ---
# Set to "false" to disable enforcement entirely (e.g. local dev when
# it gets in the way) without touching any route code — see
# app/rate_limiter.py and docs/ADR.md ADR-020.
RATE_LIMIT_ENABLED=true

# --- CORS (Day 26) ---
# Comma-separated list of origins allowed to call this API from a
# browser — the React frontend's own origin (Vite dev server, default
# port 5173). Only relevant for browser-based callers; server-to-server
# calls (curl, another backend) are never subject to CORS.
CORS_ORIGINS=http://localhost:5173

# Copy to .env and fill in real values. .env is gitignored and never
# committed — this file is the safe, placeholder-only template that is.

# --- Auth ---
SECRET_KEY=changeme-generate-a-real-random-secret
ALGORITHM=HS256
# Note: this is ACCESS_TOKEN_EXPIRE_MINUTES (plural). The real local .env
# currently has this typo'd as ACCESS_TOKEN_EXPIRE_MINUTE, which
# auth_service.py doesn't read — it silently falls back to a 30-minute
# default. Harmless today, but worth renaming in your real .env
# whenever convenient (see docs/ARCHITECTURE.md #3.5).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
# Used directly when running the app on the host (uvicorn, no Docker).
# Under `docker compose up`, docker-compose.yml overrides this with a
# value built from POSTGRES_USER/PASSWORD/DB below, pointed at the `db`
# service instead of localhost.
DATABASE_URL=postgresql://insightai:insightai@localhost:5432/insightai_dev

# Consumed by docker-compose.yml for the postgres container AND to build
# the app container's DATABASE_URL override — one source of truth for
# both, rather than two values that can drift apart.
POSTGRES_USER=insightai
POSTGRES_PASSWORD=insightai
POSTGRES_DB=insightai_dev

# --- Storage ---
# "local" (default) or "s3". S3 stays wired up but inactive until this
# is set — see app/services/storage_service.py and docs/ADR.md ADR-004.
STORAGE_BACKEND=local

# Only read when STORAGE_BACKEND=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# --- AI natural-language queries (Day 14) ---
# Real key never goes in this file or in git — add it to your local .env.
OPENAI_API_KEY=
# Configurable so swapping models later is a config change, not a code
# change — see app/services/ai_service.py.
OPENAI_MODEL=gpt-4o-mini
